# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Staff logins. Server-only: checked by /api/login, never sent to the browser.
# Use long, unique passwords. If a variable is empty, that login is disabled.
ADMIN_PASSWORD=
KITCHEN_PASSWORD=
